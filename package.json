{
  "name": "wiki",
  "license": "MIT",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@effect/platform-node": "^4.1.5",
    "effect": "^4.1.5",
    "minisearch": "^7.2.0"
  },
  "bin": {
    "wiki": "dist/wiki"
  },
  "scripts": {
    "wiki": "bun src/main.ts",
    "build": "bun scripts/build.ts",
    "install-cli": "bun run build && mkdir -p ~/.local/bin && ln -sf \"$PWD/dist/wiki\" ~/.local/bin/wiki",
    "typecheck": "tsc --noEmit"
  }
}
